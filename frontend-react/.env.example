# Copy this file to .env.local (gitignored) and fill in real values for your
# local backend. Vite only exposes variables prefixed with VITE_ to the app.

# Base URL of the Laravel backend API.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Must match INTEGRATION_API_KEY in backend-laravel/.env. Required only by
# the M2M Simulator (Settings > M2M Simulator) so its dev/demo requests can
# authenticate against /api/v1/integration/* the same way a real external
# subsystem would. Never commit the real value — this file is a template
# only and is tracked; .env.local is gitignored and is where the real key
# belongs.
VITE_INTEGRATION_API_KEY=
